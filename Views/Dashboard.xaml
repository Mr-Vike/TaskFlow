<ui:FluentWindow x:Class="TaskFlow.Views.Dashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:TaskFlow.ViewModels"
        xmlns:local="clr-namespace:TaskFlow.Models"
        Title="TESTTTT"
        Width="1280"
        Height="720"
        WindowBackdropType="Mica"
        DataContext="ViewModels/DashboardViewModel"
        ExtendsContentIntoTitleBar="True">



    <Grid>
        <ui:NavigationView PaneDisplayMode="Left"
                          IsPaneToggleVisible="False">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="1"
                                       Command="{Binding NavigationCommand}"
                                       CommandParameter="1"/>
                <ui:NavigationViewItem Content="2"
                                       Command="{Binding NavigationCommand}"
                                       CommandParameter="2"/>
                <ui:NavigationViewItem Content="3"
                                       Command="{Binding NavigationCommand}"
                                       CommandParameter="3"/>
                <ui:NavigationViewItem Content="4"
                                       Command="{Binding NavigationCommand}"
                                       CommandParameter="4"/>
                <ui:NavigationViewItem Content="5"
                                       Command="{Binding NavigationCommand}"
                                       CommandParameter="5"/>
            </ui:NavigationView.MenuItems>


        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>